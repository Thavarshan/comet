{
  "extends": "../../tsconfig.browser.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@comet/ui/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.tsx"]
}
