{
  "name": "@comet/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@comet/contracts": "*",
    "jimp": "1.6.1",
    "@comet/core": "*"
  }
}
